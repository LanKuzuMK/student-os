# Copy this file to .env for local development. Never commit .env.
# In the Neon Console: Project Dashboard > Connect > copy the complete pooled connection string.
# Keep sslmode=require and any additional query parameters provided by Neon.
DATABASE_URL=postgresql://<role>:<password>@<endpoint-pooler>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require

# Optional: limits the application-side HikariCP pool for local use.
DB_POOL_SIZE=5
