<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%
    Boolean databaseAvailable = (Boolean) request.getAttribute("databaseAvailable");
    boolean databaseReady = databaseAvailable != null && databaseAvailable;
%>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>System health - StudentOS</title><link rel="stylesheet" href="/css/main.css?v=admin-ui-20260822"><link rel="icon" type="image/png" href="/favicon.png"></head>
<body><div class="admin-shell"><aside class="admin-rail"><div class="admin-rail-logo">StudentOS <span>Admin</span></div><nav class="admin-nav" aria-label="Administrator navigation"><a href="/admin">Dashboard</a><a href="/admin/users">Users</a><a href="/admin/content">Content</a><a href="/admin/messages">Messages</a><a href="/admin/reports">Reports</a><a href="/admin/audit">Audit log</a><a href="/admin/health" class="active">System health</a><a href="/dashboard">Back to App</a></nav><div class="admin-rail-footer"><a href="/auth/logout">Logout</a></div></aside><main class="admin-main"><header class="admin-header"><div><p class="eyebrow">Operational diagnostics</p><h1>System health</h1><p>Read-only service checks for staff. This view intentionally excludes credentials, connection strings, and internal error details.</p></div><span class="admin-status">Staff only</span></header><section class="admin-workbench-grid"><article class="admin-workbench-card"><p class="eyebrow">Database reachability</p><h2><%= databaseReady ? "Available" : "Needs attention" %></h2><p><%= databaseReady ? "StudentOS completed a minimal read-only database check." : "The application could not complete its read-only database check. Review the deployment logs using the request reference from any affected error page." %></p><span class="badge <%= databaseReady ? "badge-active" : "badge-banned" %>"><%= databaseReady ? "CHECK PASSED" : "CHECK FAILED" %></span></article><article class="admin-workbench-card"><p class="eyebrow">User-facing recovery</p><h2>Trace-aware error pages</h2><p>Unexpected application errors now provide a retry path and an opaque request reference that can be matched with deployment logs without exposing user data.</p><a class="btn btn-secondary" href="/dashboard">Open student workspace</a></article></section><footer class="mkv-footer">© 2026 MKV Team</footer></main></div><script src="/js/admin-nav.js?v=20260822"></script></body></html>
