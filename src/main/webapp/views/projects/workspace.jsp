<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><c:out value="${project.title}"/> - StudentOS</title><link rel="stylesheet" href="/css/main.css?v=project-spaces-1"><link rel="icon" type="image/png" href="/favicon.png"></head>
<body><div class="app-container"><aside class="sidebar"><div class="sidebar-logo"><span class="logo-mark">S</span> Student OS</div><div class="nav-group"><div class="nav-title">Workspace</div><a href="/dashboard" class="nav-link">Overview</a><a href="/projects" class="nav-link active">Project spaces</a><a href="/goals" class="nav-link">Goals</a><a href="/schedule" class="nav-link">Schedule</a></div><div class="nav-group"><div class="nav-title">Community</div><a href="/collaborations" class="nav-link">Collaborations</a><a href="/saved" class="nav-link">Saved items</a><a href="/messages" class="nav-link">Messages<c:if test="${unreadMessageCount gt 0}"><span class="notification-badge"><c:out value="${unreadMessageCount}"/></span></c:if></a><a href="/notifications" class="nav-link">Notifications<c:if test="${unreadNotificationCount gt 0}"><span class="notification-badge"><c:out value="${unreadNotificationCount}"/></span></c:if></a></div><div class="sidebar-footer"><a href="/auth/logout" class="nav-link nav-link-danger">Log out</a></div></aside>
<main class="main-content"><a class="back-link" href="/projects">Back to Project Spaces</a><c:if test="${param.memberAdded eq '1' or param.milestoneAdded eq '1' or param.taskAdded eq '1' or param.taskUpdated eq '1'}"><div class="alert alert-success">The Project Space was updated.</div></c:if><c:if test="${not empty param.error}"><div class="alert alert-error">That update could not be completed. Check your membership and the required fields, then try again.</div></c:if>
<section class="project-workspace-hero"><div><p class="section-kicker">Private Project Space · <c:out value="${project.memberRole}"/></p><h1><c:out value="${project.title}"/></h1><p><c:out value="${project.description}" default="A private team workspace for this StudentOS project."/></p></div><span class="badge badge-todo"><c:out value="${project.status}"/></span></section>
<section class="project-overview-strip"><div><span>Members</span><strong><c:out value="${project.memberCount}"/></strong></div><div><span>Open team tasks</span><strong><c:out value="${project.activeTaskCount}"/></strong></div><div><span>Milestone progress</span><strong><c:out value="${project.milestoneProgress}"/>%</strong></div><div><span>Your access</span><strong><c:out value="${project.memberRole}"/></strong></div></section>
<section class="project-workspace-grid"><div class="project-main-column"><article class="panel"><div class="panel-heading"><div><p class="panel-kicker">Shared task board</p><h2 class="panel-title">Move the work forward</h2><p class="panel-subtitle">Members can add tasks. Owners can update any task; members can update their own or unassigned work.</p></div></div><div class="project-task-board"><c:choose><c:when test="${not empty projectTasks}"><c:forEach var="task" items="${projectTasks}"><article class="project-task-row"><div><div class="discovery-badge-row"><span class="badge badge-todo"><c:out value="${task.status}"/></span><span class="badge badge-completed"><c:out value="${task.priority}"/></span></div><h3><c:out value="${task.title}"/></h3><p><c:out value="${task.description}"/></p><small>Assigned to <strong><c:out value="${task.assigneeName}"/></strong></small></div><form method="post" action="/projects/tasks/status" class="project-status-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="projectId" value="<c:out value='${project.id}'/>"><input type="hidden" name="taskId" value="<c:out value='${task.id}'/>"><select class="form-control" name="status"><option value="TODO" <c:if test="${task.status eq 'TODO'}">selected</c:if>>To do</option><option value="IN_PROGRESS" <c:if test="${task.status eq 'IN_PROGRESS'}">selected</c:if>>In progress</option><option value="BLOCKED" <c:if test="${task.status eq 'BLOCKED'}">selected</c:if>>Blocked</option><option value="COMPLETED" <c:if test="${task.status eq 'COMPLETED'}">selected</c:if>>Completed</option></select><button class="text-action" type="submit">Update</button></form></article></c:forEach></c:when><c:otherwise><div class="project-section-empty">No shared tasks yet. Add the first small action that moves the project forward.</div></c:otherwise></c:choose></div><details class="project-add-details"><summary>Add a shared task</summary><form method="post" action="/projects/tasks/new" class="project-inline-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="projectId" value="<c:out value='${project.id}'/>"><input class="form-control" name="title" maxlength="120" required placeholder="Task title"><textarea class="form-control" name="description" maxlength="1000" rows="3" placeholder="What does done look like?"></textarea><select class="form-control" name="assigneeId"><option value="">Unassigned</option><c:forEach var="member" items="${projectMembers}"><option value="<c:out value='${member.userId}'/>"><c:out value="${member.displayName}"/></option></c:forEach></select><select class="form-control" name="priority"><option value="LOW">Low</option><option value="MEDIUM" selected>Medium</option><option value="HIGH">High</option></select><button class="btn btn-primary" type="submit">Add shared task</button></form></details></article>
<article class="panel project-milestone-panel"><div class="panel-heading"><div><p class="panel-kicker">Project path</p><h2 class="panel-title">Milestones</h2><p class="panel-subtitle">Owners define milestones so the team can see the larger path.</p></div></div><div class="project-milestone-list"><c:choose><c:when test="${not empty projectMilestones}"><c:forEach var="milestone" items="${projectMilestones}"><div class="project-milestone-row"><span class="project-milestone-dot <c:out value='${milestone.status}'/>"></span><div><strong><c:out value="${milestone.title}"/></strong><p><c:out value="${milestone.description}"/></p></div><span class="badge badge-todo"><c:out value="${milestone.status}"/></span></div></c:forEach></c:when><c:otherwise><div class="project-section-empty">No milestones have been planned yet.</div></c:otherwise></c:choose></div><c:if test="${project.owner}"><details class="project-add-details"><summary>Add milestone</summary><form method="post" action="/projects/milestones/new" class="project-inline-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="projectId" value="<c:out value='${project.id}'/>"><input class="form-control" name="title" maxlength="120" required placeholder="Milestone title"><textarea class="form-control" name="description" maxlength="500" rows="2" placeholder="Optional milestone detail"></textarea><input class="form-control" type="date" name="dueDate"><button class="btn btn-primary" type="submit">Add milestone</button></form></details></c:if></article></div>
<aside class="project-side-column"><article class="project-member-panel"><p class="section-kicker">Project team</p><h2>Members and roles</h2><div class="project-member-list"><c:forEach var="member" items="${projectMembers}"><div class="project-member-row"><span class="project-member-initial"><c:out value="${member.displayName.substring(0,1)}"/></span><div><strong><c:out value="${member.displayName}"/></strong><small><c:out value="${member.role}"/></small></div></div></c:forEach></div><c:if test="${project.owner}"><details class="project-add-details"><summary>Add accepted collaborator</summary><form method="post" action="/projects/members/add" class="project-inline-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="projectId" value="<c:out value='${project.id}'/>"><select class="form-control" name="memberId" required><option value="">Choose accepted collaborator</option><c:forEach var="collaborator" items="${eligibleCollaborators}"><option value="<c:out value='${collaborator.userId}'/>"><c:out value="${collaborator.displayName}"/></option></c:forEach></select><input type="hidden" name="role" value="CONTRIBUTOR"><button class="btn btn-secondary" type="submit">Add contributor</button></form></details></c:if></article><article class="project-team-note"><p class="section-kicker">Team agreement</p><h3>Keep the project space useful</h3><p>Use shared tasks for team work, keep personal schedule tasks private, and use direct messages for conversation that does not need a permanent project record.</p></article></aside></section><footer class="mkv-footer">© 2026 MKV Team</footer></main></div><script src="/js/mobile-nav.js?v=mobile-nav-phone-6" defer></script></body></html>
