<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Project Spaces - StudentOS</title><link rel="stylesheet" href="/css/main.css?v=project-spaces-1"><link rel="icon" type="image/png" href="/favicon.png"></head>
<body><div class="app-container"><aside class="sidebar"><div class="sidebar-logo"><span class="logo-mark">S</span> Student OS</div><div class="nav-group"><div class="nav-title">Workspace</div><a href="/dashboard" class="nav-link">Overview</a><a href="/projects" class="nav-link active">Project spaces</a><a href="/goals" class="nav-link">Goals</a><a href="/schedule" class="nav-link">Schedule</a></div><div class="nav-group"><div class="nav-title">Community</div><a href="/skills/discover" class="nav-link">Discover talent</a><a href="/collaborations" class="nav-link">Collaborations</a><a href="/saved" class="nav-link">Saved items</a><a href="/messages" class="nav-link">Messages<c:if test="${unreadMessageCount gt 0}"><span class="notification-badge"><c:out value="${unreadMessageCount}"/></span></c:if></a><a href="/notifications" class="nav-link">Notifications<c:if test="${unreadNotificationCount gt 0}"><span class="notification-badge"><c:out value="${unreadNotificationCount}"/></span></c:if></a></div><div class="sidebar-footer"><a href="/auth/logout" class="nav-link nav-link-danger">Log out</a></div></aside>
<main class="main-content"><header class="page-header"><div><p class="eyebrow">Team workspace</p><h1 class="page-title">Project Spaces</h1><p class="page-subtitle">Private workspaces for student teams to plan milestones, coordinate shared tasks, and keep progress visible.</p></div><button type="button" class="btn btn-primary" onclick="document.getElementById('projectModal').style.display='flex'">+ New project</button></header>
<c:if test="${param.error eq 'create'}"><div class="alert alert-error">Give your project a clear title of at least four characters.</div></c:if>
<section class="project-space-grid"><c:choose><c:when test="${not empty projects}"><c:forEach var="project" items="${projects}"><article class="card project-space-card"><div class="card-header"><div><p class="section-kicker"><c:out value="${project.memberRole}"/> workspace</p><h2 class="card-title"><c:out value="${project.title}"/></h2></div><span class="badge badge-todo"><c:out value="${project.status}"/></span></div><p class="project-space-description"><c:out value="${project.description}" default="A private StudentOS team project."/></p><div class="project-card-stats"><span><strong><c:out value="${project.memberCount}"/></strong> member<c:if test="${project.memberCount ne 1}">s</c:if></span><span><strong><c:out value="${project.activeTaskCount}"/></strong> open task<c:if test="${project.activeTaskCount ne 1}">s</c:if></span><span><strong><c:out value="${project.milestoneProgress}"/>%</strong> milestones</span></div><div class="owner-actions"><a class="btn btn-primary" href="/projects?id=<c:out value='${project.id}'/>">Open Project Space</a></div></article></c:forEach></c:when><c:otherwise><article class="card project-space-empty"><p class="section-kicker">Build together</p><h2>No Project Spaces yet</h2><p>Create a private project when you are ready to turn an accepted collaboration into a shared plan with milestones and team tasks.</p><button type="button" class="btn btn-primary" onclick="document.getElementById('projectModal').style.display='flex'">Create your first project</button></article></c:otherwise></c:choose></section><footer class="mkv-footer">© 2026 MKV Team</footer></main></div>
<div id="projectModal" class="project-modal" style="display:none"><div class="project-modal-card"><div class="profile-modal-heading"><div><p class="section-kicker">New private workspace</p><h2>Start a Project Space</h2></div><button type="button" class="modal-close" onclick="document.getElementById('projectModal').style.display='none'">Close</button></div><form method="post" action="/projects/new"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><div class="form-group"><label class="form-label" for="projectTitle">Project name</label><input class="form-control" id="projectTitle" name="title" maxlength="120" required placeholder="For example, Campus study planner"></div><div class="form-group"><label class="form-label" for="projectDescription">Project purpose</label><textarea class="form-control" id="projectDescription" name="description" maxlength="1000" rows="4" placeholder="What is the team building, researching, or planning?"></textarea></div><div class="project-modal-actions"><button class="btn btn-secondary" type="button" onclick="document.getElementById('projectModal').style.display='none'">Cancel</button><button class="btn btn-primary" type="submit">Create Project Space</button></div></form></div></div><script src="/js/mobile-nav.js?v=mobile-nav-phone-7" defer></script></body></html>
