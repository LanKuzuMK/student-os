<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Collaborations - StudentOS</title><link rel="stylesheet" href="/css/main.css?v=collaborations-1"><link rel="icon" type="image/png" href="/favicon.png"></head>
<body>
<div class="app-container">
    <aside class="sidebar">
        <div class="sidebar-logo"><span class="logo-mark">S</span> Student OS</div>
        <div class="nav-group"><div class="nav-title">Workspace</div><a href="/dashboard" class="nav-link">Overview</a><a href="/projects" class="nav-link">Project spaces</a><a href="/goals" class="nav-link">Goals</a><a href="/schedule" class="nav-link">Schedule</a></div>
        <div class="nav-group"><div class="nav-title">Community</div><a href="/skills/discover" class="nav-link">Discover talent</a><a href="/skills" class="nav-link">My skills</a><a href="/collaborations" class="nav-link active">Collaborations</a><a href="/messages" class="nav-link">Messages<c:if test="${unreadMessageCount gt 0}"><span class="notification-badge"><c:out value="${unreadMessageCount}"/></span></c:if></a><a href="/notifications" class="nav-link">Notifications<c:if test="${unreadNotificationCount gt 0}"><span class="notification-badge"><c:out value="${unreadNotificationCount}"/></span></c:if></a><a href="/profile" class="nav-link">My profile</a></div>
        <div class="nav-group"><div class="nav-title">Opportunities</div><a href="/freelance" class="nav-link">Freelance jobs</a><a href="/freelance/services" class="nav-link">Services</a></div>
        <div class="sidebar-footer"><a href="/auth/logout" class="nav-link nav-link-danger">Log out</a></div>
    </aside>
    <main class="main-content">
        <header class="page-header"><div><p class="eyebrow">Student network</p><h1 class="page-title">Collaborations</h1><p class="page-subtitle">Turn a good profile match into a clear proposal with a purpose, expected commitment, and a simple response.</p></div><a class="btn btn-secondary" href="/skills/discover">Discover students</a></header>
        <c:if test="${param.sent eq '1'}"><div class="alert alert-success">Your collaboration proposal was sent.</div></c:if><c:if test="${param.responded eq '1'}"><div class="alert alert-success">Your response was saved and the student was notified.</div></c:if><c:if test="${param.cancelled eq '1'}"><div class="alert alert-success">Your pending proposal was cancelled.</div></c:if><c:if test="${param.cancelled eq '0' or param.error eq 'response'}"><div class="alert alert-error">That request could not be updated. It may already have changed.</div></c:if><c:if test="${param.error eq 'proposal'}"><div class="alert alert-error">Add a clear title and at least 20 characters explaining the collaboration before sending.</div></c:if><c:if test="${param.error eq 'duplicate'}"><div class="alert alert-error">You already have a pending proposal with the same title for this student.</div></c:if>
        <c:choose><c:when test="${not empty proposalRecipient}">
            <section class="profile-form-card collaboration-proposal-card"><div class="profile-section-heading"><div><p class="section-kicker">New proposal</p><h2>Propose a collaboration to <c:out value="${proposalRecipient.email}"/></h2></div><p>Keep the request practical. The recipient can accept or decline it, and both students can continue in Messages afterwards.</p></div>
                <form method="post" action="/collaborations/new"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="recipientId" value="<c:out value='${proposalRecipient.id}'/>"><div class="profile-field-grid"><div class="form-group"><label class="form-label" for="requestType">Collaboration type</label><select class="form-control" id="requestType" name="requestType" required><option value="PROJECT">Project collaboration</option><option value="STUDY_GROUP">Study group</option><option value="SKILL_EXCHANGE">Skill exchange</option><option value="FREELANCE">Freelance opportunity</option><option value="OTHER">Other collaboration</option></select></div><div class="form-group"><label class="form-label" for="expectedCommitment">Expected commitment</label><input class="form-control" id="expectedCommitment" name="expectedCommitment" maxlength="120" placeholder="For example, 2 hours each week"></div></div><div class="form-group"><label class="form-label" for="title">Proposal title</label><input class="form-control" id="title" name="title" maxlength="120" required placeholder="For example, Build a campus study planner"></div><div class="form-group"><label class="form-label" for="description">What are you proposing?</label><textarea class="form-control" id="description" name="description" maxlength="1000" rows="5" required placeholder="Describe the goal, what you are contributing, and what you are asking from the other student."></textarea><small>Use at least 20 characters and keep the proposal respectful.</small></div><div class="owner-actions"><button class="btn btn-primary" type="submit">Send proposal</button><a class="btn btn-secondary" href="javascript:history.back()">Cancel</a></div></form>
            </section>
        </c:when><c:otherwise><section class="card collaboration-start-card"><p class="section-kicker">Start with context</p><h2>Find a student, then send a clear proposal</h2><p>Visit a classmate’s public profile from Discover talent and choose <strong>Propose collaboration</strong>. A structured request helps both students understand the goal before they begin messaging.</p><a class="btn btn-primary" href="/skills/discover">Explore student skills</a></section></c:otherwise></c:choose>
        <section class="collaboration-board"><div class="collaboration-board-heading"><div><p class="section-kicker">Request board</p><h2>Your incoming and outgoing proposals</h2></div><p>Pending incoming proposals appear first, followed by your sent requests and completed decisions.</p></div><div class="collaboration-list"><c:choose><c:when test="${not empty collaborationRequests}"><c:forEach items="${collaborationRequests}" var="proposal"><article class="collaboration-request-card"><div class="card-header"><div><p class="section-kicker"><c:choose><c:when test="${proposal.incoming}">Received from</c:when><c:otherwise>Sent to</c:otherwise></c:choose> <c:out value="${proposal.counterpartName}"/></p><h3><c:out value="${proposal.title}"/></h3></div><span class="badge ${proposal.status eq 'PENDING' ? 'badge-todo' : 'badge-completed'}"><c:out value="${proposal.status}"/></span></div><div class="discovery-badge-row"><span class="badge badge-completed"><c:out value="${proposal.requestTypeLabel}"/></span><c:if test="${not empty proposal.expectedCommitment}"><span class="badge badge-todo"><c:out value="${proposal.expectedCommitment}"/></span></c:if></div><p class="collaboration-description"><c:out value="${proposal.description}"/></p><c:if test="${not empty proposal.responseNote}"><p class="collaboration-response-note"><strong>Response:</strong> <c:out value="${proposal.responseNote}"/></p></c:if><div class="owner-actions"><a class="btn btn-secondary" href="/messages?toEmail=<c:out value='${proposal.counterpartEmail}'/>">Message</a><c:if test="${proposal.incoming and proposal.status eq 'PENDING'}"><form method="post" action="/collaborations/respond" class="collaboration-response-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="requestId" value="<c:out value='${proposal.id}'/>"><input class="form-control" name="responseNote" maxlength="500" placeholder="Optional response note"><button class="btn btn-primary" type="submit" name="status" value="ACCEPTED">Accept</button><button class="btn btn-secondary" type="submit" name="status" value="DECLINED">Decline</button></form></c:if><c:if test="${not proposal.incoming and proposal.status eq 'PENDING'}"><form method="post" action="/collaborations/cancel"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="requestId" value="<c:out value='${proposal.id}'/>"><button class="text-action text-action-danger" type="submit" onclick="return confirm('Cancel this pending collaboration proposal?')">Cancel proposal</button></form></c:if></div></article></c:forEach></c:when><c:otherwise><div class="card collaboration-empty"><h3>No collaboration requests yet</h3><p>Use Discover talent to find complementary skills, then propose a study group, project, skill exchange, or freelance idea with enough context to get a useful response.</p><a class="btn btn-secondary" href="/skills/discover">Discover classmates</a></div></c:otherwise></c:choose></div></section>
        <footer class="mkv-footer">© 2026 MKV Team</footer>
    </main>
</div>
<script src="/js/mobile-nav.js?v=mobile-nav-phone-5" defer></script>
</body>
</html>
