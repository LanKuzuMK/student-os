<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Student OS</display-name>

    <filter>
        <filter-name>unreadMessageFilter</filter-name>
        <filter-class>com.studentos.filter.UnreadMessageFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>unreadMessageFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <servlet>
        <servlet-name>signInController</servlet-name>
        <servlet-class>com.studentos.controller.SignInController</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>signInController</servlet-name>
        <url-pattern>/auth/signin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>dashboardController</servlet-name>
        <servlet-class>com.studentos.controller.DashboardController</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>dashboardController</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>scheduleController</servlet-name>
        <servlet-class>com.studentos.controller.ScheduleController</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>scheduleController</servlet-name>
        <url-pattern>/schedule</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>messageController</servlet-name>
        <servlet-class>com.studentos.controller.MessageController</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>messageController</servlet-name>
        <url-pattern>/messages</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>authController</servlet-name>
        <servlet-class>com.studentos.controller.AuthController</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/auth/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/auth/verify</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/auth/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/auth/logout</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/auth/forgot</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>authController</servlet-name>
        <url-pattern>/auth/reset</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>passwordController</servlet-name>
        <servlet-class>com.studentos.controller.PasswordController</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>passwordController</servlet-name>
        <url-pattern>/account/password</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/views/error/500.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/views/error/403.jsp</location>
    </error-page>

</web-app>
